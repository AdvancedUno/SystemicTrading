# Copy this to .env and fill in actual values. Never commit .env.

# === Alpaca (free paper trading account: https://alpaca.markets) ===
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER=true
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# === Binance Testnet (free: https://testnet.binance.vision) ===
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# === Storage ===
DATA_DIR=./data
DATABASE_URL=postgresql://quant:quant@localhost:5432/quant

# === MLflow ===
MLFLOW_TRACKING_URI=http://localhost:5000

# === Logging ===
LOG_LEVEL=INFO
ENVIRONMENT=development
